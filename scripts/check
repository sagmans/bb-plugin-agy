#!/usr/bin/env bash
# One fail-closed entry point keeps local validation and push validation identical.
set -euo pipefail
readonly local_timeout=120
readonly network_timeout=180
readonly max_ccn=15
readonly max_fn_length=100
root=$(git rev-parse --show-toplevel)
cd "$root"
# shellcheck source=.githooks/lib/helpers.sh
. "$root/.githooks/lib/helpers.sh"
# Only disposable at_sha worktrees need installation; never replace a clone's dependencies.
if [[ ! -d node_modules ]]; then
	run_step 'locked dependencies' "$network_timeout" npm ci --ignore-scripts
fi
run_step 'secret scan (history)' "$local_timeout" gitleaks git --config .githooks/lib/gitleaks.toml --redact --no-banner --log-level warn .
run_step 'secret scan (working tree)' "$local_timeout" gitleaks git --pre-commit --config .githooks/lib/gitleaks.toml --redact --no-banner --log-level warn .
run_step 'format and lint' "$local_timeout" npm run lint
run_step 'typecheck' "$local_timeout" npm run typecheck
run_step 'duplication' "$local_timeout" npm run duplicates
run_step 'complexity' "$local_timeout" lizard -C "$max_ccn" -L "$max_fn_length" -w src scripts server.ts host.ts app.tsx
run_step 'static analysis' "$local_timeout" env SEMGREP_SEND_METRICS=off SEMGREP_ENABLE_VERSION_CHECK=0 semgrep scan --config .githooks/lib/semgrep --metrics=off --disable-version-check --severity ERROR --error --quiet --emacs src scripts server.ts host.ts app.tsx .githooks/pre-commit.d .githooks/pre-push.d
run_step 'dependency audit (npm)' "$network_timeout" npm audit
run_step 'dependency audit (osv)' "$network_timeout" osv-scanner scan source --no-call-analysis=all -L package-lock.json
run_step 'build' "$local_timeout" npm run build
run_step 'shell analysis' "$local_timeout" shellcheck -x scripts/setup-hooks scripts/check .githooks/pre-commit.d/* .githooks/pre-push.d/*
run_step 'shell format' "$local_timeout" shfmt -d scripts/check .githooks/pre-commit.d .githooks/pre-push.d
run_step 'markdown' "$local_timeout" markdownlint-cli2 README.md PLUGIN_OVERVIEW.md AGENTS.md skills/agy-provider/SKILL.md
# Exercises offline fixtures, real subprocess failure budgets, RPC/dialect contracts, and live quota.
run_step 'usage smoke' "$local_timeout" npm run smoke
printf 'All project checks passed.\n'
