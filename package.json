{
  "name": "bb-plugin-agy",
  "version": "0.3.0",
  "private": true,
  "description": "bb plugin that runs Google Antigravity (agy) as a first-class agent provider, with full-colour branding and live quota usage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagmans/bb-plugin-agy.git"
  },
  "homepage": "https://github.com/sagmans/bb-plugin-agy#readme",
  "bugs": {
    "url": "https://github.com/sagmans/bb-plugin-agy/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "antigravity",
    "agy",
    "acp",
    "provider"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Antigravity",
    "description": "Run bb threads with Google Antigravity (agy) with official multicolor branding and Provider usage quota.",
    "branding": {
      "icon": "./icons/antigravity.svg",
      "logo": {
        "light": "./icons/antigravity-logo.svg"
      },
      "experimental_icons": {
        "agy": "./icons/antigravity.svg"
      }
    },
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "agy",
        "displayName": "Antigravity"
      }
    ],
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "duplicates": "jscpd src scripts server.ts host.ts app.tsx --threshold 0 --reporters console",
    "smoke": "node scripts/smoke-usage.ts",
    "build": "bb plugin build .",
    "check": "bash scripts/check"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "22.19.1",
    "@types/react": "19.2.14",
    "jscpd": "5.4.2",
    "typescript": "5.9.3"
  }
}
